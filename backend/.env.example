# HSclubs backend - local development environment variables
#
# Copy this file to backend/.env and fill in real values.
# backend/.env is gitignored; never commit real secrets.
#
# Spring Boot loads this file automatically because
# application.yaml imports "optional:file:.env[.properties]".

# === Required for local MySQL development ===

# MySQL connection string. The default creates a database called "mydb"
# on first connect (createDatabaseIfNotExist=true).
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/mydb?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=replace-with-your-local-mysql-password

# === Required for Google OAuth login ===

# Create OAuth credentials in Google Cloud Console:
#   https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must end with /api/auth/google/callback
GOOGLE_CLIENT_ID=replace-with-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# === Platform owners ===

# Comma-separated emails granted platform-owner role on first login.
APP_OWNER_EMAILS=you@example.com

# === Optional ===

# Frontend origin used for CORS and OAuth callback.
# Defaults to http://localhost:4173 in DEPLOYMENT.md.
FRONTEND_ORIGIN=http://localhost:4173

# Override the local upload directory (default: backend/uploads).
# APP_UPLOAD_DIR=uploads

# Instagram club avatars are cached through Instaloader.
# From the repository root, initialize and validate the Linux environment with:
#   ./scripts/setup-instaloader.sh --configure-env
#   ./scripts/setup-instaloader.sh --configure-env --check
# The setup command writes these values with an absolute Python path:
# APP_INSTAGRAM_AVATAR_CACHE_ENABLED=true
# APP_INSTAGRAM_AVATAR_PYTHON_COMMAND=/absolute/path/to/backend/.venv/bin/python
#
# Required for Instaloader: configure one authenticated source below. Anonymous
# Instaloader access is not supported because Instagram returns 403 Forbidden.
#
# Option A: import Instagram cookies from a browser already logged into Instagram.
# Firefox and browser-cookie3 support are installed by the setup script.
# Supported values include firefox, chrome, safari, edge, brave, and vivaldi.
# APP_INSTAGRAM_AVATAR_COOKIE_BROWSER=firefox
# APP_INSTAGRAM_AVATAR_COOKIE_FILE=/absolute/path/to/browser/cookies.sqlite
#
# Option B: use a saved Instaloader session.
# Create it separately with `instaloader --login your_username`.
# APP_INSTAGRAM_AVATAR_SESSION_USER=your_username
# APP_INSTAGRAM_AVATAR_SESSION_FILE=/absolute/path/to/session-your_username
#
# APP_INSTAGRAM_AVATAR_FETCH_TIMEOUT_MS=10000
# Cached files are refreshed after 60 days (approximately two months).
# APP_INSTAGRAM_AVATAR_CACHE_TTL_MS=5184000000
# Keep this above the number of Instagram-linked clubs so the first scheduled
# pass can populate every local icon.
# APP_INSTAGRAM_AVATAR_MAX_REFRESH_PER_RUN=120
# The scheduler checks twice daily so failed refreshes can be retried without
# downloading fresh avatars again.
# Optional: override the unauthenticated web profile API fallback used when
# Instaloader cannot resolve a profile picture.
# APP_INSTAGRAM_AVATAR_PROFILE_API_URL_TEMPLATE=https://www.instagram.com/api/v1/users/web_profile_info/?username=%s
# APP_INSTAGRAM_AVATAR_REFRESH_FIXED_DELAY_MS=43200000
#
# How long a failed avatar fetch for a given handle is remembered before it is
# retried again (default 15 minutes), so a persistently-broken handle can't be
# hammered on every request for it.
# APP_INSTAGRAM_AVATAR_NEGATIVE_CACHE_TTL_MS=900000
# Caps how many distinct handles the public on-demand endpoint
# (GET /api/avatars/instagram/{handle}) will fetch concurrently; only known
# club handles ever reach this point at all (see AvatarCacheController).
# APP_INSTAGRAM_AVATAR_MAX_CONCURRENT_ON_DEMAND_REFRESHES=4
# How long the set of club-linked Instagram handles is cached before that
# "is this a known club handle" check (see above) re-queries the club table
# (default 5 minutes). A newly added/edited handle becomes fetchable within
# this window without a restart or waiting for the 12-hour prewarm.
# APP_INSTAGRAM_AVATAR_KNOWN_HANDLES_CACHE_TTL_MS=300000

# Override the OAuth authorization base path (default: /api/auth/authorize).
# APP_AUTHORIZATION_REQUEST_BASE_URI=/api/auth/authorize

# === CSRF / session cookie hardening ===

# Session cookie SameSite policy. Must stay "lax" -- "strict" breaks the Google
# OAuth2 redirect callback (a cross-site top-level navigation) and login stops
# working with "authorization_request_not_found".
# SESSION_COOKIE_SAME_SITE=lax

# Server-side CSRF token enforcement (in addition to the SameSite cookie above).
# Defaults to false. Only set to true once the frontend reads the XSRF-TOKEN
# cookie and sends it back as the X-XSRF-TOKEN header on state-changing requests.
# APP_CSRF_ENABLED=false
