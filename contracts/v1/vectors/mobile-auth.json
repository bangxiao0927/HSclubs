{
  "contract": "hsclubs.mobile-auth",
  "version": 1,
  "description": "Fixed vectors every implementation must reproduce. Same numbers in the school template, the guiding page and the app, so a disagreement shows up as a failing test instead of as a sign-in that silently never completes.",
  "pkce": {
    "note": "RFC 7636 appendix B. Verifier is ASCII; the challenge is base64url of the SHA-256 digest, without padding.",
    "codeVerifier": "dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk",
    "codeChallengeMethod": "S256",
    "codeChallenge": "E9Melhoa2OwvFrEMTJguCHaoeK1t8URWbuGJSstw-cM",
    "mismatchedVerifier": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  },
  "oneTimeCode": {
    "note": "Only the digest is stored. A database read must not be enough to complete somebody else's sign-in.",
    "code": "K7hQ2mZ1tN8sV4wR0yB6cJ3xL5pD9fGa",
    "storedDigestAlgorithm": "sha-256",
    "storedDigestHex": "05ccdca47e597aa6194e59a0e559b6df3f4867603ef144a2f00bb28e91882fed",
    "lifetimeSeconds": { "min": 60, "max": 120 },
    "singleUse": true
  },
  "startUrl": {
    "note": "Parameter order is not significant; percent-encoding is.",
    "schoolStartEndpoint": "https://hsclubs.net/api/mobile-auth/start",
    "example": "https://hsclubs.net/api/mobile-auth/start?schoolId=sch_7Qb3Xf9KLm2ZpR4tVn6Y&state=M2Rk8sYq1vB7nT4wX0cLpZ&code_challenge=E9Melhoa2OwvFrEMTJguCHaoeK1t8URWbuGJSstw-cM&code_challenge_method=S256&redirect_uri=https%3A%2F%2Fclubs.bangxiao.net%2Fmobile-auth%2Fcallback&return_to=%2Fclubs%2Frobotics%3Ftab%3Dmembers"
  },
  "callbackUrl": {
    "success": "https://clubs.bangxiao.net/mobile-auth/callback?schoolId=sch_7Qb3Xf9KLm2ZpR4tVn6Y&state=M2Rk8sYq1vB7nT4wX0cLpZ&code=K7hQ2mZ1tN8sV4wR0yB6cJ3xL5pD9fGa",
    "cancelled": "https://clubs.bangxiao.net/mobile-auth/callback?schoolId=sch_7Qb3Xf9KLm2ZpR4tVn6Y&state=M2Rk8sYq1vB7nT4wX0cLpZ&error=access_denied"
  },
  "expectedFailures": [
    { "case": "state does not match a pending flow", "error": "invalid_state", "httpStatus": 400 },
    { "case": "code replayed after a successful complete", "error": "invalid_grant", "httpStatus": 400 },
    { "case": "verifier does not hash to the stored challenge", "error": "invalid_grant", "httpStatus": 400 },
    { "case": "code older than its lifetime", "error": "expired_code", "httpStatus": 400 },
    { "case": "schoolId is not this deployment", "error": "unknown_school", "httpStatus": 404 },
    { "case": "redirect_uri is not a registered callback", "error": "invalid_request", "httpStatus": 400 },
    { "case": "person cancelled at the identity provider", "error": "access_denied", "httpStatus": 400 }
  ]
}
